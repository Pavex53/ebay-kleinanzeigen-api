# PostgreSQL - use a long, random password in production
POSTGRES_DB=kleinanzeigen_saas
POSTGRES_USER=kleinanzeigen
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Public HTTPS URL used for Stripe Checkout redirects and the Stripe webhook endpoint.
# Example webhook URL: https://api.example.de/webhooks/stripe
BASE_URL=https://api.example.de

# Stripe test keys first; use live keys only after successful end-to-end tests.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_BASIC=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_EXPERT=price_replace_me

# Generate or rotate through @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_me
